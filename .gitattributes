# Normalize all text files to LF line endings in the repository, regardless of
# the contributor's platform or local core.autocrlf setting. This prevents the
# "file renders as one long line" symptom that occurs when CR characters slip
# in from a Windows checkout or a misbehaving editor.

# Default: treat any auto-detected text file as text and store with LF.
* text=auto eol=lf

# Swift sources — explicit so diff/blame are anchored to the language.
*.swift     text eol=lf diff=swift

# Common text formats that show up in this project.
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.sh        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.txt       text eol=lf
*.xib       text eol=lf
*.storyboard text eol=lf
*.plist     text eol=lf
LICENSE     text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# SVG is text but vector — keep it text so diffs work.
*.svg       text eol=lf

# Binary assets — opt out of any text handling.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.heic      binary
*.tiff      binary
*.gif       binary
*.icns      binary
*.pdf       binary
*.aiff      binary
*.aif       binary
*.m4a       binary
*.mp3       binary
*.wav       binary
*.zip       binary
*.tar.gz    binary
*.dmg       binary
*.app       binary
